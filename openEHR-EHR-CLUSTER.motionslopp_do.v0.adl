definition
	CLUSTER[at0000] matches {    -- Motionslopp_DO
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Loppets namn
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Typ av motion
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0005,    -- Cykling
							at0006,    -- Löpning
							at0007,    -- Skidåkning
							at0008]    -- Simmning
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Träningsvana
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0009,    -- Nybörjare
							at0010,    -- Motionsidrottare
							at0011]    -- Elitidrottare
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Antal tidigare deltagande i detta lopp
				value matches {
					DV_COUNT matches {
						magnitude matches {|>=0|}
					}
				}
			}
			ELEMENT[at0014] occurrences matches {0..1} matches {    -- Tid efter start
				value matches {
					DV_DURATION matches {*}
				}
			}
			CLUSTER[at0019] occurrences matches {0..1} matches {    -- Position
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0020] occurrences matches {0..1} matches {    -- Latitud
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::497]>
								list = <
									["1"] = <
										units = <"deg">
									>
								>
							>
						}
					}
					ELEMENT[at0021] occurrences matches {0..1} matches {    -- Longitud
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::497]>
								list = <
									["1"] = <
										units = <"deg">
									>
								>
							>
						}
					}
				}
			}
			CLUSTER[at0015] occurrences matches {0..1} matches {    -- Plats
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0016] occurrences matches {0..1} matches {    -- Sträcka från start
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::122]>
								list = <
									["1"] = <
										units = <"m">
									>
									["2"] = <
										units = <"km">
									>
								>
							>
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {    -- Adress eller beskrivning
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

